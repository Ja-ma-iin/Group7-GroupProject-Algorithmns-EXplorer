    // =====================================================
    // PERFORMANCE LINE CHART
    // =====================================================

    private static class PerformanceChart extends JPanel {

        private int[] inputSizes = new int[0];

        private String[] algorithmNames = new String[0];

        private double[][] executionTimes =
                new double[0][];

        private final Color[] lineColors = {
                new Color(46, 116, 181),
                new Color(220, 90, 70),
                new Color(50, 150, 100),
                new Color(150, 90, 180),
                new Color(220, 160, 50),
                new Color(70, 160, 170)
        };

        PerformanceChart(String[] defaultNames) {

            algorithmNames = defaultNames;

            setBackground(Color.WHITE);

            setBorder(
                    new EmptyBorder(15, 15, 15, 15)
            );
        }

        void setData(
                int[] sizes,
                String[] names,
                double[][] times) {

            inputSizes = Arrays.copyOf(
                    sizes,
                    sizes.length
            );

            algorithmNames = Arrays.copyOf(
                    names,
                    names.length
            );

            executionTimes = new double[times.length][];

            for (int i = 0; i < times.length; i++) {

                executionTimes[i] = Arrays.copyOf(
                        times[i],
                        times[i].length
                );
            }

            repaint();
        }

        void clear() {

            inputSizes = new int[0];
            executionTimes = new double[0][];

            repaint();
        }

        @Override
        protected void paintComponent(Graphics g) {

            super.paintComponent(g);

            Graphics2D g2 = (Graphics2D) g.create();

            g2.setRenderingHint(
                    RenderingHints.KEY_ANTIALIASING,
                    RenderingHints.VALUE_ANTIALIAS_ON
            );

            if (inputSizes.length == 0
                    || executionTimes.length == 0) {

                g2.setColor(UITheme.MUTED);
                g2.setFont(UITheme.NORMAL_FONT);

                String message =
                        "Performance chart will appear here.";

                FontMetrics fm = g2.getFontMetrics();

                g2.drawString(
                        message,
                        (getWidth() - fm.stringWidth(message)) / 2,
                        getHeight() / 2
                );

                g2.dispose();
                return;
            }

            int left = 75;
            int right = getWidth() - 35;
            int top = 35;
            int bottom = getHeight() - 85;

            if (right <= left || bottom <= top) {
                g2.dispose();
                return;
            }

            double maxTime = 0;

            for (double[] series : executionTimes) {

                for (double value : series) {

                    if (Double.isFinite(value) && value >= 0) {

                        maxTime = Math.max(
                                maxTime,
                                value
                        );
                    }
                }
            }

            if (maxTime <= 0) {
                maxTime = 1;
            }

            // Horizontal grid lines
            g2.setFont(
                    new Font("Segoe UI", Font.PLAIN, 10)
            );

            for (int i = 0; i <= 5; i++) {

                int y = bottom
                        - (i * (bottom - top) / 5);

                double labelValue =
                        maxTime * i / 5.0;

                g2.setColor(
                        new Color(230, 234, 239)
                );

                g2.drawLine(
                        left,
                        y,
                        right,
                        y
                );

                g2.setColor(UITheme.MUTED);

                String label = String.format(
                        "%.2f",
                        labelValue
                );

                FontMetrics fm = g2.getFontMetrics();

                g2.drawString(
                        label,
                        left - fm.stringWidth(label) - 8,
                        y + 4
                );
            }

            // Axes
            g2.setColor(UITheme.TEXT);

            g2.drawLine(
                    left,
                    top,
                    left,
                    bottom
            );

            g2.drawLine(
                    left,
                    bottom,
                    right,
                    bottom
            );

            // Plot algorithm lines
            for (int a = 0;
                    a < executionTimes.length;
                    a++) {

                double[] series = executionTimes[a];

                g2.setColor(
                        lineColors[a % lineColors.length]
                );

                g2.setStroke(
                        new BasicStroke(
                                2.2f,
                                BasicStroke.CAP_ROUND,
                                BasicStroke.JOIN_ROUND
                        )
                );

                int previousX = -1;
                int previousY = -1;

                for (int i = 0;
                        i < inputSizes.length
                                && i < series.length;
                        i++) {

                    double value = series[i];

                    if (!Double.isFinite(value)
                            || value < 0) {

                        previousX = -1;
                        previousY = -1;

                        continue;
                    }

                    int x;

                    if (inputSizes.length == 1) {

                        x = (left + right) / 2;

                    } else {

                        x = left + (
                                i * (right - left)
                                        / (inputSizes.length - 1)
                        );
                    }

                    int y = bottom - (int) (
                            (value / maxTime)
                                    * (bottom - top)
                    );

                    if (previousX != -1) {

                        g2.drawLine(
                                previousX,
                                previousY,
                                x,
                                y
                        );
                    }

                    g2.fillOval(
                            x - 4,
                            y - 4,
                            8,
                            8
                    );

                    previousX = x;
                    previousY = y;
                }
            }

            // X-axis labels
            g2.setColor(UITheme.MUTED);

            for (int i = 0;
                    i < inputSizes.length;
                    i++) {

                int x;

                if (inputSizes.length == 1) {

                    x = (left + right) / 2;

                } else {

                    x = left + (
                            i * (right - left)
                                    / (inputSizes.length - 1)
                    );
                }

                String label = String.valueOf(
                        inputSizes[i]
                );

                FontMetrics fm = g2.getFontMetrics();

                g2.drawString(
                        label,
                        x - fm.stringWidth(label) / 2,
                        bottom + 18
                );
            }

            // Axis titles
            g2.setColor(UITheme.TEXT);

            g2.drawString(
                    "Input Size (n)",
                    (left + right) / 2 - 35,
                    bottom + 38
            );

            g2.drawString(
                    "Time (ms)",
                    8,
                    18
            );

            // Chart legend
            int legendX = left;
            int legendY = bottom + 62;

            g2.setFont(
                    new Font("Segoe UI", Font.PLAIN, 10)
            );

            for (int i = 0;
                    i < algorithmNames.length;
                    i++) {

                g2.setColor(
                        lineColors[i % lineColors.length]
                );

                g2.fillOval(
                        legendX,
                        legendY - 7,
                        8,
                        8
                );

                g2.setColor(UITheme.TEXT);

                g2.drawString(
                        algorithmNames[i],
                        legendX + 13,
                        legendY
                );

                FontMetrics fm = g2.getFontMetrics();

                legendX += fm.stringWidth(
                        algorithmNames[i]
                ) + 35;

                if (legendX > right - 120) {

                    legendX = left;
                    legendY += 16;
                }
            }

            g2.dispose();
        }
    }
}
